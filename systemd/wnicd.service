# Example unit. bin/install.sh writes the live copy to
# /etc/systemd/system/wnicd.service with the installing user's uid and
# capture directory. Do not copy this file as-is onto another machine.
[Unit]
Description=Radio Lab multi-WNIC monitor and capture helper
After=network-pre.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/lib/radio-lab/wnicd daemon --foreground --allow-uid 1000 --capture-dir /home/USER/radio-lab/captures
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
